# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/freelancer_auto.db
LOG_LEVEL=INFO
SCHEDULER_INTERVAL_MINUTES=10
ENABLE_SCHEDULER=false

# Set true to exercise the complete local workflow with built-in sample projects.
FREELANCER_MOCK_MODE=true
FREELANCER_BASE_URL=https://www.freelancer.com
FREELANCER_ACCESS_TOKEN=
FREELANCER_BIDDER_ID=
# Real submission stays disabled until you explicitly enable it.
FREELANCER_BID_SUBMISSION_ENABLED=false
# The API is paginated in batches of 100; 300 retrieves up to three pages per cycle.
FREELANCER_FETCH_LIMIT=300
# By default, every screened project from a 300-project fetch is sent for AI analysis.
ANALYSIS_BATCH_LIMIT=300

# Project operating strategy. Starter is the default for building initial reviews.
OPERATING_MODE=starter
# Starter progress is recorded manually on the project page; it is not inferred from the API.
STARTER_REVIEW_COUNT=0
STARTER_COMPLETED_PROJECTS=0

# OpenAI-compatible AI provider. Do not hard-code provider URLs or keys in source.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=3
AI_DRY_RUN=true

# ntfy
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NOTIFY_SCORE_THRESHOLD=70

# Bid safety limits
MAX_BIDS_PER_HOUR=2
MAX_BIDS_PER_DAY=8
